{
  "name": "recall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite preview --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "content:build": "node scripts/build-reviewed-content.mjs",
    "content:check": "node scripts/export-retrieval-baseline.mjs && node scripts/check-reviewed-content.mjs",
    "content:runtime": "vite build --config scripts/quality-check.config.mjs && node artifacts/quality-check/check.mjs",
    "lint": "eslint src --quiet",
    "format": "prettier --write \"src/**/*.tsx\" \"src/**/*.ts\" \"src/**/*.css\"",
    "format:check": "prettier --check \"src/**/*.tsx\" \"src/**/*.ts\" \"src/**/*.css\"",
    "workshop:check": "node --test public/workshop/checks/*.test.mjs public/workshop/capstone/typescript/reference/server.test.mjs",
    "workshop:content": "node scripts/check-workshop.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.9",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "unified": "^11.0.5",
    "vite": "^8.1.1",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "ts-fsrs": "^5.4.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
